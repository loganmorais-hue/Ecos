* {
    margin: 0;
    padding: 0;
}

body {
    background-color: #07162b;
    color: #ffffff;
    font-family: Arial, Helvetica, sans-serif;
}

header {
    background-color: #06101f;
    border-bottom: 2px solid #1bd4e5;
}

.cabecalho {
    width: 1000px;
    margin: auto;
    padding: 20px 0;
}

.logo {
    display: inline-block;
    color: #ffffff;
    width: 100px;
    margin-right: 60px;
}
.texto-principal h2 span {
    color: #1bd4e5;
}

nav {
    display: inline-block;
}

nav a {
    color: #c8d3df;
    font-size: 17px;
    font-weight: bold;
    margin-right: 22px;
    text-decoration: none;
}

nav a:hover,
nav .ativo {
    color: #1bd4e5;
}

.busca {
    display: inline-block;
}

.busca label {
    display: none;
}

.busca input {
    background-color: #ff8b42;
    border: 0;
    border-radius: 18px;
    color: #000000;
    padding: 9px 15px;
    width: 175px;
    margin-left:220px;
}
.perfil {
    background-color: #0b4586;
    border: 0;
    border-radius: 180px;
    height: 40px;
    width: 40px;
    display: inline-block;
    vertical-align: middle;
    margin-left:25px;
}
main {
    width: 1000px;
    margin: auto;
}

.apresentacao {
    border-bottom: 1px solid #29425c;
    min-height: 370px;
    padding: 70px 0 45px 0;
}

.texto-principal {
    display: inline-block;
    width: 570px;
    vertical-align: top;
}

.aviso {
    color: #ff8b42;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
    margin-bottom: 15px;
}

.texto-principal h2 {
    font-size: 53px;
    line-height: 60px;
    margin-bottom: 20px;
}

.descricao {
    color: #c8d3df;
    font-size: 17px;
    line-height: 25px;
    margin-bottom: 28px;
    width: 470px;
}

.botao {
    background-color: #ff6b32;
    border: 2px solid #ff6b32;
    border-radius: 20px;
    color: #ffffff;
    display: inline-block;
    font-size: 15px;
    font-weight: bold;
    margin-right: 10px;
    padding: 11px 18px;
    text-decoration: none;
}

.botao:hover {
    background-color: #ff8b42;
    border-color: #ff8b42;
}

.botao-vazio {
    background-color: transparent;
    color: #ff8b42;
}

.botao-vazio:hover {
    color: #ffffff;
}

.vantagens {
    margin-top: 34px;
}

.vantagem {
    display: inline-block;
    margin-right: 20px;
    vertical-align: top;
}

.icone {
    color: #1bd4e5;
    display: inline-block;
    font-size: 25px;
    margin-right: 7px;
    vertical-align: middle;
}

.vantagem p {
    color: #aebdcb;
    display: inline-block;
    font-size: 12px;
    line-height: 18px;
    vertical-align: middle;
}

.vantagem strong {
    color: #ffffff;
    font-size: 13px;
}

.destaque {
    background-color: #102b49;
    border: 4px solid #1bd4e5;
    border-radius: 180px;
    display: inline-block;
    height: 360px;
    text-align: center;
    vertical-align: top;
    width: 360px;
}

.foto-fone {
    height: 350px;
    margin-top:3px;
    width: 265px;
}
.fundo-fone {
  height: 590px;
  width: 580px;
  margin-top: -480px;
  margin-left: -110px;
}
.secao {
    padding: 20px 0;
}

.secao h2 {
    font-size: 27px;
    margin-bottom: 8px;
}

.introducao {
    color: #c8d3df;
    margin-bottom: 20px;
}

.lista-musicas {
    text-align: center;
}

.musica {
    background-color: #10213a;
    border-radius: 100=px;
    display: inline-block;
    margin-right: 14px;
    overflow: hidden;
    text-align: left;
    vertical-align: top;
    width: 235px;
}

.musica:last-child {
    margin-right: 0;
}

.musica:hover {
    outline: 2px solid #1bd4e5;
}

.capa {
    color: #ffffff;
    font-size: 60px;
    padding: 24px 0;
    text-align: center;
}

.azul .capa {
    background-color: #168ca0;
}

.roxa .capa {
    background-color: #6750a4;
}

.rosa .capa {
    background-color: #a14f7a;
}

.laranja .capa {
    background-color: #bb6b35;
}

.musica h3 {
    font-size: 17px;
    margin: 15px 15px 5px 15px;
}

.musica p {
    color: #c8d3df;
    margin: 0 15px 11px 15px;
}

.musica span {
    color: #1bd4e5;
    display: block;
    font-size: 13px;
    margin: 0 15px 16px 15px;
}

.playlists {
    border-top: 1px solid #29425c;
}

.playlists ul {
    margin-left: 22px;
    margin-top: 20px;
}

.playlists li {
    color: #c8d3df;
    margin-bottom: 10px;
}
